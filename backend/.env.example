# Flowise
FLOWISE_URL=http://localhost:3000
FLOWISE_TOKEN=your-flowise-token
FLOW_ID=your-flow-id

# Supabase (для проверки JWT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server
PORT=3001

# AITunnel LLM Proxy
# Обязательный: API-ключ для авторизации в AITunnel
AITUNNEL_API_KEY=your-aitunnel-api-key
# Базовый URL AITunnel API (по умолчанию https://api.aitunnel.ru/v1)
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
# Таймаут запроса к AITunnel в миллисекундах (по умолчанию 120000)
AITUNNEL_TIMEOUT_MS=120000
# Разрешённые модели через запятую (по умолчанию deepseek-v4-flash)
AITUNNEL_ALLOWED_MODELS=deepseek-v4-flash
# Включить расширенное логирование запросов/ответов (true/false, по умолчанию false)
LLM_PROXY_DEBUG=false
